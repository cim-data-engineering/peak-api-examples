# Copy this file to .env in the repo root and paste your offline token below.
# .env is gitignored; a real environment variable of the same name wins over it.
#
# The offline token is the only value the scripts need. To get one:
#
#     uv run scripts/get_token.py
#
# It is a long-lived credential -- it authenticates as you until revoked, so
# treat it like a password.
OFFLINE_TOKEN_ACCESS=
